# Local full-mode LLM generation config. Copy this file to .env and fill the real key.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# Local full mode requires the three local model directories under models/.
VLM_ENABLED=true
RERANKER_ENABLED=true

# Optional: enable LLM evaluation in later loop optimization stages.
LLM_EVAL_ENABLED=false

# Web smoke only logs in a pre-created administrator. Keep real values out of Git.
KNOWLEDGE_AGENT_SMOKE_ADMIN_USERNAME=
KNOWLEDGE_AGENT_SMOKE_ADMIN_PASSWORD=
